set_param('Lab1_Model','RelTol','1e-6','AbsTol','1e-9');

% Q1 - 1% settling time
M_Load_1 = [10, 20, 30, 40, 50, 60, 80, 100, 110, 120, 130, 140, 150, 175, 200, 225, 250, 300, 350, 400 450, 500, 600, 650, 700, 750, 800, 850, 875, 900, 925, 950, 975, 1000];
ts_toolbox = zeros(1, length(M_Load_1));
ts_manual = zeros(1, length(M_Load_1));

for i1 = 1:length(M_Load_1)
    M2 = M_Load_1(i1);
    sim('Lab1_Model');
    
    t_1 = x1_dot.time;
    v1_1 = x1_dot.signals.values;
    
    % Filters data to only be within desired 50s window
    valid_idx = find(t_1 <= 50);
    t_1step = t_1(valid_idx);
    v1_1step = v1_1(valid_idx);
    
    % Toolbox Plug-in Method
    v_ss = F / (mu * g * (M1 + M2));
    info = stepinfo(v1_1step, t_1step, v_ss, 'SettlingTimeThreshold', 0.01);
    ts_toolbox(i1) = info.SettlingTime;
    
    % Manual Computation Method
    up_bound = v_ss * 1.01;
    lo_bound = v_ss * 0.99;
    outside_bounds_idx = find(v1_1step < lo_bound | v1_1step > up_bound);
    
    % Examines arrays to find where last entry into +/- 1% is
    if isempty(outside_bounds_idx)
        ts_manual(i1) = 0; 
    else
        pv_outside = outside_bounds_idx(end);
        if pv_outside < length(t_1step)
            ts_manual(i1) = t_1step(pv_outside + 1); 
        else
            ts_manual(i1) = NaN;
        end
    end

    fprintf('M2=%.0f  ts_manual=%.3f  ts_toolbox=%.3f\n', M2, ts_manual(i1), ts_toolbox(i1));
end

M2 = M2_initial;

% Plot both manual 1% and Toolbox 1% settling time vs load mass
figure;
plot(M_Load_1, ts_toolbox, 'r', M_Load_1, ts_manual, 'b');
legend('Toolbox Plug-in', 'Manual Computation');

title('1% Settling Time vs. Load Mass');
xlabel('Load Mass (kg)');
ylabel('Settling Time (s)');
grid on;

